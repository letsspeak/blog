{
    "name": "lsklab-blog",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=20.19"
    },
    "scripts": {
        "dev": "npm run build:articles && vite",
        "dev:watch": "concurrently \"npm run dev\" \"node scripts/watch-articles.js\"",
        "build:articles": "tsx scripts/build-articles.ts",
        "build": "vite build && npm run build:articles",
        "preview": "vite preview",
        "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings 0",
        "format": "prettier --write \"**/*.{ts,tsx,md,json,yml}\"",
        "typecheck": "tsc --noEmit -p tsconfig.json"
    },
    "dependencies": {
        "@tailwindcss/typography": "^0.5.16",
        "gray-matter": "^4.0.3",
        "marked": "^18.1.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-router-dom": "^7.18.4"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@tailwindcss/postcss": "^4.3.3",
        "@types/node": "^22.20.5",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "chokidar": "^4.0.3",
        "concurrently": "^9.1.2",
        "eslint": "^9.39.5",
        "eslint-config-prettier": "^10.1.0",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "globals": "^17.13.0",
        "postcss": "^8.4.36",
        "prettier": "^3.2.5",
        "tailwindcss": "^4.3.3",
        "tsx": "^4.23.15",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.72.0",
        "vite": "^8.3.5"
    },
    "overrides": {
        "glob": "^10.3.10",
        "rimraf": "^4.4.1",
        "postcss-selector-parser": "^7.1.6"
    }
}
